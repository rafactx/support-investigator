{
  "name": "support-investigator",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts",
    "build:web": "pnpm --filter web build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json && pnpm --filter web typecheck",
    "lint": "biome lint .",
    "test": "vitest run",
    "evals:intake": "node --env-file-if-exists=.env --experimental-strip-types src/evals/run-intake-evals.ts",
    "evals:intake:live": "node --env-file-if-exists=.env --experimental-strip-types src/evals/run-intake-evals-live.ts",
    "smoke:deployed": "node --env-file-if-exists=.env --experimental-strip-types src/evals/run-deployed-smoke.ts",
    "kb:refresh": "node --env-file-if-exists=.env --experimental-strip-types src/kb/kb-refresh.ts",
    "cdk": "cdk --app \"node --env-file-if-exists=.env --experimental-strip-types infra/main.ts\"",
    "cf:dev": "pnpm build:web && wrangler d1 migrations apply support-investigator --local && wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply support-investigator --remote",
    "cf:check": "wrangler deploy --dry-run --outdir dist/worker",
    "cf:deploy": "pnpm build:web && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.135",
    "@aws-sdk/client-bedrock-runtime": "3.1165.0",
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/client-ssm": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@xenova/transformers": "2.17.2",
    "agents": "0.33.0",
    "ai": "7.0.166",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/vitest-plugin": "1.6.1",
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "26.6.6",
    "aws-cdk": "2.1148.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.159.0",
    "yaml": "2.9.1"
  }
}
