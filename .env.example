# Copy to .env for local overrides (`pnpm dev`, evals and `pnpm cdk` load it
# automatically; .env is gitignored). Every variable is optional: with none
# set, everything runs offline against fixtures.

# --- Language Assistance (intake proposal, explanation improvement) --------
# fake (default for `pnpm dev serve`: proposes nothing, no network),
# workers-ai (default on the Cloudflare Worker) or bedrock (default on the
# AWS Lambda). See ADR-0047 and ADR-0048 for spend bounds.
# LANGUAGE_MODEL_PROVIDER=fake
# Per-call model timeout in ms (default 4000, at most 20000).
# LANGUAGE_ASSISTANCE_TIMEOUT_MS=4000

# Workers AI from Node scripts (`pnpm dev serve`, `pnpm evals:intake:live`,
# `EMBED_PROVIDER=workers-ai pnpm kb:refresh`). The deployed Worker uses its
# AI binding instead and needs neither. The token needs Workers AI: Read.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Bedrock: a region-prefixed inference-profile id (bare model ids fail with
# "on-demand throughput isn't supported"). Uses ambient AWS credentials.
# MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1

# --- Knowledge Index embeddings ---------------------------------------------
# lexical (default: deterministic hashing bag-of-words, the committed index),
# workers-ai, bedrock-titan, or local. Queries always use the provider
# recorded in the index (ADR-0009), so switching is a `pnpm kb:refresh` rebuild.
# EMBED_PROVIDER=lexical
# WORKERS_AI_EMBED_MODEL=@cf/baai/bge-m3

# --- Public-demo abuse controls (src/api/public-demo-guard.ts, ADR-0047) ----
# Read by the middleware. On the Cloudflare Worker, DEMO_KEY and
# RATE_LIMIT_SALT are `wrangler secret put` secrets, per-client limits are the
# rate-limit bindings in wrangler.jsonc, and only
# RATE_LIMIT_MODEL_PER_DAY_GLOBAL is a var (default 50 there).
# DEMO_KEY=                          # optional; a matching x-demo-key bypasses rate limits
# RATE_LIMIT_SALT=                   # salt for the client-address digest; set a random value
# RATE_LIMIT_CREATE_PER_HOUR=30      # investigations created, per client
# RATE_LIMIT_MODEL_PER_HOUR=10       # model-assisted requests, per client
# RATE_LIMIT_MODEL_PER_DAY_GLOBAL=500 # model-assisted requests, all clients
# RATE_LIMIT_WRITES_PER_HOUR=120     # intake corrections and reviews, per client
# RATE_LIMIT_MCP_PER_HOUR=120        # Support MCP requests, per client

# --- Reference AWS deployment (CDK) ----------------------------------------
# Required for a real `pnpm cdk deploy`/`destroy` against your account;
# unset gives an environment-agnostic stack, which CI's `cdk synth` uses.
CDK_ACCOUNT_ID=
CDK_REGION=us-east-2

# DynamoDB repository contract tests against a scratch table (optional;
# skipped when unset — docs/runbooks/dynamodb-integration-tests.md).
# INVESTIGATION_TABLE_NAME=

# Deployed release smoke (`pnpm smoke:deployed`, docs/release-evidence.md).
# SUPPORT_INVESTIGATOR_API_URL=
# SUPPORT_INVESTIGATOR_DEMO_KEY=
